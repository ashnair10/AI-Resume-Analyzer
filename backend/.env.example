# AI (optional; deterministic analysis works without this)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin
CORS_ORIGINS=http://localhost:3000

# Observability
SERVICE_NAME=techcv-api
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional LLM observability / governance integration points
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AZURE_APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
